# Server configuration
RESELL_SERVER_PORT=8080
RESELL_SERVER_READ_TIMEOUT=15s
RESELL_SERVER_WRITE_TIMEOUT=15s

# Database configuration
RESELL_DATABASE_HOST=localhost
RESELL_DATABASE_PORT=5432
RESELL_DATABASE_USER=postgres
RESELL_DATABASE_PASSWORD=postgres
RESELL_DATABASE_DBNAME=resell
RESELL_DATABASE_SSLMODE=disable

# Redis configuration
RESELL_REDIS_HOST=localhost
RESELL_REDIS_PORT=6379
RESELL_REDIS_PASSWORD=
RESELL_REDIS_DB=0

# Keycloak configuration
RESELL_KEYCLOAK_URL=http://localhost:8180
RESELL_KEYCLOAK_REALM=resell
RESELL_KEYCLOAK_CLIENT_ID=resell-api
RESELL_KEYCLOAK_CLIENT_SECRET=
